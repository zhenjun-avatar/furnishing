# salon_gateway — copy keys into src/agent/.env (or export). Prefix: SALON_

SALON_LOG_LEVEL=INFO

# Optional: scripts/test_salon_gateway.py (not read by the gateway process)
# SALON_TEST_BASE_URL=https://your-public-domain.example

# 企业微信自建应用「接收消息」回调
# 生产：密文模式（SALON_WECOM_PLAINTEXT=false）并填写三项
SALON_WECOM_PLAINTEXT=true
SALON_WECOM_TOKEN=
SALON_WECOM_ENCODING_AES_KEY=
SALON_WECOM_CORP_ID=

# 对话：LangGraph + tools.llm（与 core.config 共用 .env）
# 在 src/agent/.env 配置 DEFAULT_MODEL、DEEPSEEK_API_KEY / QWEN_API_KEY / OPENAI_API_KEY 等。
# 图片多模态请用带视觉的模型（如 qwen-vl-plus、gpt-4o）。
# SALON_LLM_MODEL=     # 非空则覆盖 DEFAULT_MODEL
# SALON_LLM_TEMPERATURE=0.7
#
# 仍用于拉取 upload.dify.ai 等外链原图（万相 / 兼容旧链）：
SALON_DIFY_DEFAULT_INPUTS_JSON={}
SALON_DIFY_API_BASE=https://api.dify.ai/v1
SALON_DIFY_API_KEY=
SALON_DIFY_USER_PREFIX=wecom

# 门店/项目下拉选项（与 booking 相同 Bearer）：GET /internal/booking-options?store_q=东&service_q=染
# 数据来自飞书表中 feishu_field_map 的 store（单选）、service（多选）列定义；用于 H5/小程序/Dify 外部数据源做搜索筛选
#
# Dify HTTP 工具回调：POST /internal/booking；留空则关闭该路由
# 必须与 Dify「提交预约」HTTP 节点里 Bearer 的密钥完全一致（与导入 DSL 默认 41 字符占位符无关）。
# 若日志出现 parsed_token_len=41：多为 Dify HTTP 节点 Bearer 与网关本变量不一致，请在 Dify 中改为与本变量相同的值。
# 401 时日志含 parsed_token_sha256_12 / accepted_token_sha256_12；本地比对：python -c "import hashlib;print(hashlib.sha256('粘贴SALON值'.encode()).hexdigest()[:12])"
SALON_INTERNAL_BOOKING_TOKEN=

# 模拟企微文本 → LangGraph（JSON）：POST /simulate/wecom-text；生产务必留空
# 鉴权：Authorization: Bearer <同此值> 或 X-Salon-Token
# 本地 CLI：python scripts/simulate_wecom.py 你好 | python scripts/simulate_wecom.py --chat
# SALON_SIMULATE_TOKEN=

# 通义万相（家居效果示意图等，可选）
# 不配置则 POST /internal/home-furnishing-preview、POST /internal/furnishing-compose-preview 等返回 503。
SALON_DASHSCOPE_API_KEY=
# SALON_WANXIANG_MODEL=wanx2.1-imageedit
# 万相 2.7 图+文编辑：wan2.7-image 或 wan2.7-image-pro
# SALON_WANXIANG_MODEL=wan2.7-image-pro
# 国内账号（默认）：https://dashscope.aliyuncs.com/api/v1
# 国际站账号（新加坡）：https://dashscope-intl.aliyuncs.com/api/v1
# SALON_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# 家居内部 HTTP（原 Dify Chatflow 可对照 deploy/dify/home_furnishing_showcase_chatflow.yml）
# - POST /internal/conversation-image  缓存首轮房间图（Bearer 同 SALON_INTERNAL_BOOKING_TOKEN）
# - POST /internal/home-furnishing-preview  按已确认方案生图（见 ImagePreviewRequest）
# - GET  /internal/furnishing-assets?q=&category=&limit=   素材库检索（默认 salon_gateway/data/furnishing_assets.json）
# - POST /internal/furnishing-compose-preview  空间图 + 多张产品参考图 → 效果图（仅 wan2.7-image / wan2.7-image-pro）
# - GET  /furnishing-asset-files/<文件名>  公网静态素材（无 Bearer；与 JSON 中 https://域名/前缀/furnishing-asset-files/… 对齐）
# SALON_FURNISHING_ASSETS_FILE=   # 可选；覆盖默认 JSON 路径
# 若公网基址不是 https://quizmesh.tech/salon ，请改 furnishing_assets.json 里各 image_url
# 家居示意更推荐 wan2.7-image / wan2.7-image-pro；wanx2.1-imageedit 走 description_edit。

# 飞书多维表（可选）。不配则预约仅打日志。
SALON_FEISHU_APP_ID=
SALON_FEISHU_APP_SECRET=
SALON_FEISHU_BITABLE_APP_TOKEN=
SALON_FEISHU_BITABLE_TABLE_ID=
# JSON：BookingDraft 字段名 -> 飞书列名
# service 映射飞书「多选」列：请求 JSON 用数组，如 ["染发","烫发"]；单字符串表示只选一个
# 建议（customers+tickets 精简版字段）：
# {"name":"姓名","phone":"手机号","wechat_id":"微信ID","city":"城市","budget_range":"预算区间","style_pref":"风格偏好","status":"客户状态","conversation_id":"会话ID","ticket_type":"咨询类型","content_summary":"需求摘要","appointment_time":"预约时间","store":"门店","product_ids":"产品ID列表","room_image_url":"实景图URL","preview_url":"效果图URL","ticket_status":"工单状态","result":"结果","channel":"渠道","external_user_id":"外部ID","notes":"备注"}
# 可选新增（客服任务）：{"contact_status":"留资状态","handoff_requested":"是否转人工","handoff_reason":"转人工原因","appointment_intent":"预约意向"}
SALON_FEISHU_FIELD_MAP_JSON={}
# 可选：列名 -> 类型（覆盖自动推断）；支持 Text/Phone/Url/DateTime/SingleSelect/MultiSelect
# {"手机号":"Phone","咨询类型":"SingleSelect","预约时间":"DateTime","效果图URL":"Url"}
# SALON_FEISHU_FIELD_TYPES_JSON={}
